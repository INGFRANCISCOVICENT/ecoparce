# Copie este archivo como .env y complete los valores. NUNCA suba el .env a Git ni lo comparta por chat.
# En el servidor: chmod 600 .env

# ===== Desarrollo local rápido =====
DB_ENGINE=sqlite
# Sin SMTP, los códigos de verificación se imprimen en la consola de runserver.

# ===== Producción (PythonAnywhere) =====
# DJANGO_SETTINGS_MODULE=config.settings.produccion
# Genere las dos claves con:  python manage.py generar_claves
# DJANGO_SECRET_KEY=
# MFA_CLAVE_CIFRADO=            (cifra los secretos de la verificación en dos pasos; si se pierde, todos deben reconfigurar su 2FA)
# Al rotar claves, la anterior va en DJANGO_SECRET_KEY_ANTERIOR / MFA_CLAVE_CIFRADO_ANTERIOR durante un tiempo.
# ALLOWED_HOSTS=www.ecoparce.com.co
# SITE_URL=https://www.ecoparce.com.co
# CONTACTO_SEGURIDAD=seguridad@ecoparce.com.co

# Base de datos MySQL 8 (pestaña Databases de PythonAnywhere)
# DB_ENGINE=mysql
# DB_NAME=usuario$ecoparce
# DB_USER=usuario
# DB_PASSWORD=
# DB_HOST=usuario.mysql.pythonanywhere-services.com

# Ingreso con Google (Google Auth Platform → Clientes → Aplicación web)
# Redirect URI autorizado: https://www.ecoparce.com.co/accounts/google/login/callback/
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=

# Correo para los códigos de verificación y alertas (igual que CiudadReporta)
# Opción A · Resend:  SMTP_HOST=smtp.resend.com  SMTP_USER=resend  SMTP_PASSWORD=re_xxx (API key)
# Opción B · Gmail:   SMTP_HOST=smtp.gmail.com   SMTP_USER=tu-correo@gmail.com  SMTP_PASSWORD=(contraseña de aplicación)
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SSL=1
# SMTP_USER=
# SMTP_PASSWORD=
# CORREO_REMITENTE=EcoParce <no-responder@ecoparce.com.co>
# VERIFICAR_MX_CORREO=1

# Opcional: exigir que los administradores entren con Google (además de la 2FA obligatoria)
# PANEL_SOLO_GOOGLE=1
